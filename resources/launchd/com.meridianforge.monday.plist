<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.meridianforge.monday</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>bash</string>
        <string>-lc</string>
        <string>cd ~/Documents/MeridianForge/04_Automation/Mac/MeridianForge && source venv/bin/activate && python -c "from meridianforge.cli.schedule_command import run_schedule; raise SystemExit(run_schedule())"</string>
