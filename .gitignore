# ======================================
# Meridian Forge Git Ignore
# ======================================


# ======================================
# Python
# ======================================

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/

# Python build artifacts
build/
dist/
*.egg-info/


# ======================================
# Testing
# ======================================

.pytest_cache/
.coverage
htmlcov/


# ======================================
# IDE / Editor
# ======================================

.vscode/
.idea/


# ======================================
# Operating System
# ======================================

.DS_Store


# ======================================
# Environment / Secrets
# ======================================

.env
.env.*
!.env.example


# ======================================
# Meridian Forge Generated Artifacts
# ======================================

# Runtime logs
*.log

# Temporary files
*.tmp
*.cache


# ======================================
# Reports
# ======================================

# Generated reports only
reports/output/
reports/generated/


# Generated exports
reports/output/*.xlsx
reports/generated/*.xlsx


# ======================================
# Update System
# ======================================

# Deployment backups
updates/backups/

# Temporary update workspace
updates/tmp/


# Keep release packages tracked:
# updates/packages/


# Ignore Python cache inside packages
updates/packages/*/files/**/__pycache__/


# ======================================
# Local Runtime Data
# ======================================

# Local databases
*.sqlite
*.db


# ======================================
# Coverage / Analysis Output
# ======================================

.mypy_cache/
.ruff_cache/


# ======================================
# OS Metadata
# ======================================

.Trashes
.AppleDouble
.LSOverride
# Meridian Forge runtime outputs
runtime/outputs/*.md
runtime/outputs/*.xlsx
runtime/outputs/*.csv

# Meridian Forge runtime outputs
runtime/outputs/*.md
runtime/outputs/*.xlsx
runtime/outputs/*.csv

# Meridian Forge runtime outputs
runtime/outputs/*.md
runtime/outputs/*.xlsx
runtime/outputs/*.csv
