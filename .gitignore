# ======================================
# Meridian Forge Git Ignore
# ======================================


# Python
__pycache__/
*.py[cod]
*$py.class


# Virtual environments
venv/
.venv/


# Build artifacts
build/
dist/
*.egg-info/


# Testing
.pytest_cache/
.coverage
htmlcov/


# IDE
.vscode/
.idea/


# OS
.DS_Store


# Environment
.env


# ======================================
# Meridian Forge Generated Artifacts
# ======================================

# Update backups
# updates/backups/

# Temporary packages
updates/tmp/

# Local generated reports
reports/output/
reports/generated/

# Generated Excel exports
*.xlsx


# ======================================
# Package history
# ======================================

# Keep manifests and release packages
# but ignore generated backup copies

updates/packages/*/files/__pycache__/


# ======================================
# Runtime
# ======================================

*.log
*.tmp
*.cache

# ======================================
# Meridian Forge Update System
# ======================================

# Release packages are intentionally tracked:
# updates/packages/

# Deployment backups are local only:
updates/backups/