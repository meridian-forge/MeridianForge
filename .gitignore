# ======================================
# Meridian Forge Git Ignore
# ======================================


# ======================================
# Python
# ======================================

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/

# Python build artifacts
build/
dist/
*.egg-info/


# ======================================
# Testing
# ======================================

.pytest_cache/
.coverage
htmlcov/


# ======================================
# IDE / Editor
# ======================================

.vscode/
.idea/


# ======================================
# Operating System
# ======================================

.DS_Store


# ======================================
# Environment / Secrets
# ======================================

.env
.env.*
!.env.example


# ======================================
# Meridian Forge Generated Artifacts
# ======================================

# Runtime logs
*.log

# Temporary files
*.tmp
*.cache


# ======================================
# Reports
# ======================================

# Generated reports only
reports/output/
reports/generated/


# Generated exports
reports/output/*.xlsx
reports/generated/*.xlsx


# ======================================
# Update System
# ======================================

# Deployment backups
updates/backups/

# Temporary update workspace
updates/tmp/


# Keep release packages tracked:
# updates/packages/


# Ignore Python cache inside packages
updates/packages/*/files/**/__pycache__/


# ======================================
# Meridian Forge Runtime Workspace
# ======================================

runtime/*
!runtime/
!runtime/outputs/
runtime/outputs/*
!runtime/outputs/.gitkeep
!runtime/outputs/.gitkeep
Documentation/Artifacts/Exports/

# --------------------------------------------------
# Local developer environment
# --------------------------------------------------
dev.sh

# Python
.venv/
venv/
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Runtime output
runtime/

# IDE
.vscode/
.idea/

# Coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/


# MeridianForge local validation artifacts
property.xlsx
samples/
scripts/gmail_auth_bootstrap.py
